            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"namaLengkap\": \"Fito Maulana\",\n  \"username\": \"fitomaulana2\",\n  \"email\": \"fitomaulana2@example.com\",\n  \"nomorTelepon\": \"081299887711\",\n  \"password\": \"password123\",\n  \"role\": \"user\"\n}"
